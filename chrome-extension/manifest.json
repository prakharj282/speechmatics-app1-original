{
    "manifest_version": 3,
    "name": "Sales Copilot Bridge",
    "version": "1.2",
    "description": "Bridge between React App and AI Platforms (Multitarget)",
    "permissions": [
        "tabs",
        "scripting",
        "activeTab"
    ],
    "host_permissions": [
        "https://platform.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://ai-sandbox.berkeley.edu/*",
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:5175/*",
        "http://localhost:5176/*",
        "http://localhost:5177/*",
        "http://localhost:5178/*",
        "http://localhost:3000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "http://localhost:5173/*",
                "http://localhost:5174/*",
                "http://localhost:5175/*",
                "http://localhost:5176/*",
                "http://localhost:5177/*",
                "http://localhost:5178/*",
                "http://localhost:3000/*"
            ],
            "js": [
                "content.js"
            ]
        },
        {
            "matches": [
                "https://platform.openai.com/*",
                "https://chatgpt.com/*",
                "https://claude.ai/*",
                "https://ai-sandbox.berkeley.edu/*"
            ],
            "js": [
                "content_adapter.js"
            ]
        }
    ],
    "commands": {
        "send-conversation": {
            "suggested_key": {
                "default": "Alt+A"
            },
            "description": "Send Conversation Chunk"
        },
        "send-helper": {
            "suggested_key": {
                "default": "Alt+S"
            },
            "description": "Send Helper Chunk"
        },
        "send-combined": {
            "suggested_key": {
                "default": "Alt+D"
            },
            "description": "Send Combined Chunk"
        }
    }
}
